{
  "name": "autologin",
  "version": "1.0.0",
  "description": "A calm, local-first login workspace for Windows.",
  "main": "./out/main/index.js",
  "author": "AutoLogin",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:before": "npm run build:backend && npm run prepare:sidecar && npm run dev:renderer",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:electron": "electron-vite dev",
    "typecheck": "npm run typecheck:tauri",
    "typecheck:tauri": "tsc --noEmit -p tsconfig.tauri.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "tauri build",
    "build:before": "npm run typecheck:tauri && npm run build:renderer && npm run build:backend && npm run prepare:sidecar",
    "build:renderer": "vite build --config vite.config.ts",
    "build:backend": "node scripts/build-backend.mjs",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "build:electron": "npm run typecheck:electron && electron-vite build",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run --configLoader runner",
    "test:e2e": "npm run build:electron && playwright test",
    "package": "npm run build",
    "package:electron": "npm run build:electron && electron-builder --win nsis --x64",
    "package:electron:dir": "npm run build:electron && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "hash-wasm": "4.12.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.66.0",
    "playwright": "1.64.1",
    "png-to-ico": "^3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "com.autologin.desktop",
    "productName": "AutoLogin",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "outputs",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "resources/update-config.json",
        "to": "update-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "AutoLogin-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AptimLvStic",
        "repo": "AutoLogin",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "differentialPackage": "store-asar",
      "allowToChangeInstallationDirectory": true,
      "include": "resources/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AutoLogin",
      "uninstallDisplayName": "AutoLogin"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "builder-util-runtime": "^9.7.0",
    "csv-parse": "^7.0.3",
    "electron-updater": "^6.8.11",
    "kdbxweb": "^2.1.1",
    "undici": "^7.30.2"
  }
}
