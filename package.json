{
  "name": "autologin",
  "version": "1.0.5",
  "description": "A calm, local-first login workspace for Windows.",
  "author": "AutoLogin",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:before": "npm run build:backend && npm run verify:backend && npm run prepare:sidecar && npm run dev:renderer",
    "dev:renderer": "vite --config vite.config.ts",
    "typecheck": "npm run typecheck:tauri",
    "typecheck:tauri": "tsc --noEmit -p tsconfig.tauri.json && tsc --noEmit -p tsconfig.web.json",
    "build": "tauri build",
    "build:before": "npm run typecheck:tauri && npm run build:renderer && npm run build:backend && npm run verify:backend && npm run prepare:sidecar",
    "build:renderer": "vite build --config vite.config.ts",
    "build:backend": "node scripts/build-backend.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run --configLoader runner",
    "package": "npm run build"
  },
  "devDependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "^0.28.2",
    "hash-wasm": "4.12.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.66.0",
    "png-to-ico": "^3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "csv-parse": "^7.0.3",
    "kdbxweb": "^2.1.1",
    "undici": "^7.30.2"
  }
}
