{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoLogin",
  "version": "0.10.0",
  "identifier": "com.autologin.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:before",
    "beforeBuildCommand": "npm run build:before"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoLogin",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#F7F8FA",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-backend/backend.cjs": "backend/backend.cjs",
      "../PRIVACY.md": "PRIVACY.md",
      "../resources/icon.ico": "icon.ico",
      "../resources/icon.png": "icon.png",
      "../resources/update-config.json": "update-config.json",
      "resources/bin/node.exe": "bin/node.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../resources/icon.ico",
        "uninstallerIcon": "../resources/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "AutoLogin"
      }
    }
  }
}
